<mujoco model="puma560">
    <compiler angle="radian" autolimits="true"/>
    <option timestep="0.002" gravity="0 0 -9.81"/>

    <asset>
        <mesh name="puma_link1" file="meshes/puma_link1.stl"
              scale="0.0254 0.0254 0.0254"/>
        <mesh name="puma_link2" file="meshes/puma_link2.stl"
              scale="0.0254 0.0254 0.0254"/>
        <mesh name="puma_link3" file="meshes/puma_link3.stl"
              scale="0.0254 0.0254 0.0254"/>
        <mesh name="puma_link4" file="meshes/puma_link4.stl"
              scale="0.0254 0.0254 0.0254"/>
        <mesh name="puma_link5" file="meshes/puma_link5.stl"
              scale="0.0254 0.0254 0.0254"/>
        <mesh name="puma_link6" file="meshes/puma_link6.stl"
              scale="0.0254 0.0254 0.0254"/>
        <mesh name="puma_link7" file="meshes/puma_link7.stl"
              scale="0.0254 0.0254 0.0254"/>
    </asset>

    <visual>
        <global offwidth="1280" offheight="900"/>
    </visual>

    <default>
        <joint damping="2" armature="0.02"
               limited="true" range="-3.14159265 3.14159265"/>
        <geom contype="0" conaffinity="0"
              density="900" friction="0.8 0.1 0.1"/>
        <position kp="100" kv="15"/>
    </default>

    <worldbody>
        <light pos="1 -2 3" dir="-0.2 0.3 -1"/>
        <camera name="main_camera"
                pos="1.6 -2.2 1.3"
                xyaxes="0.81 0.59 0 -0.22 0.30 0.93"/>
        <geom name="floor" type="plane"
              size="3 3 0.1" rgba="0.8 0.8 0.8 1"/>

        <!-- Link frames and fixed offsets follow the PUMA 560 URDF. -->
        <body name="link1" pos="0 0 0.01">
            <geom name="puma_link1_geom" type="mesh" mesh="puma_link1"
                  euler="0 0 1.57079632679" rgba="0.18 0.35 0.62 1"/>

            <body name="link2" pos="0 0 0.6718"
                  euler="1.57079632679 0 0">
                <joint name="joint1" type="hinge" axis="0 1 0"/>
                <geom name="puma_link2_geom" type="mesh" mesh="puma_link2"
                      pos="0 0 -0.1" rgba="0.18 0.35 0.62 1"/>

                <body name="link3">
                    <joint name="joint2" type="hinge" axis="0 0 1"/>
                    <geom name="puma_link3_geom" type="mesh" mesh="puma_link3"
                          pos="0 0 0.1936" rgba="0.83 0.45 0.12 1"/>

                    <body name="link4" pos="0.4318 -0.0203 0.1501"
                          euler="0 0 -1.57079632679">
                        <joint name="joint3" type="hinge" axis="0 0 1"/>
                        <geom name="puma_link4_geom" type="mesh" mesh="puma_link4"
                              rgba="0.83 0.45 0.12 1"/>

                        <body name="link5"
                              euler="1.57079632679 0 1.57079632679">
                            <joint name="joint4" type="hinge" axis="0 0 1"/>
                            <geom name="puma_link5_geom" type="mesh" mesh="puma_link5"
                                  pos="0 0 0.3621"
                                  euler="0 0 1.57079632679"
                                  rgba="0.18 0.55 0.72 1"/>

                            <body name="link6" pos="0 0 0.4331"
                                  euler="1.57079632679 0 0">
                                <joint name="joint5" type="hinge"
                                       axis="0 0 1"/>
                                <geom name="puma_link6_geom" type="mesh" mesh="puma_link6"
                                      euler="3.14159265359 0 1.57079632679"
                                      rgba="0.18 0.55 0.72 1"/>

                                <body name="link7" pos="0 0.0558 0"
                                      euler="-1.57079632679 0 0">
                                    <joint name="joint6" type="hinge"
                                           axis="0 0 1"/>
                                    <geom name="puma_link7_geom" type="mesh"
                                          mesh="puma_link7" pos="0 0 -0.010"
                                          rgba="0.18 0.55 0.72 1"/>
                                    <site name="ee_site" pos="0 0 0"
                                          size="0.015" rgba="1 0 0 1"/>
                                </body>
                            </body>
                        </body>
                    </body>
                </body>
            </body>
        </body>
    </worldbody>

    <actuator>
        <position name="motor1" joint="joint1"/>
        <position name="motor2" joint="joint2"/>
        <position name="motor3" joint="joint3"/>
        <position name="motor4" joint="joint4"/>
        <position name="motor5" joint="joint5"/>
        <position name="motor6" joint="joint6"/>
    </actuator>
</mujoco>
